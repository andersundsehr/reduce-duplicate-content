{
  "name": "andersundsehr/reduce-duplicate-content",
  "description": "redirect if page has a / at the end (or not). (reduce Duplicate Content)",
  "license": [
    "GPL-2.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "typo3/cms-core": "^11.5.11 || ^12.4.37 || ^13.4.35"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.31 || ^10.5.62",
    "pluswerk/grumphp-config": "^6.4 || ^7.2.0 || ^10.1.3 || ^11.2.0",
    "saschaegerer/phpstan-typo3": "^1.8.2 || ^2.1.1",
    "ssch/typo3-rector": "^1.1.3 || ^2.15.2 || ^3.6.2"
  },
  "autoload": {
    "psr-4": {
      "AUS\\ReduceDuplicateContent\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AUS\\ReduceDuplicateContent\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "reduce_duplicate_content"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php Tests/Unit/"
  }
}
